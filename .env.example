# Server wallets are derived from this seed. On Railway set it to
# ${{secret(64, "abcdef0123456789")}} so no person ever sees it.
ACCRUE_KEY_SEED=
# Public origin, for the ERC-8004 agent card and demo proof pages.
PUBLIC_URL=http://localhost:3000
# Optional: Claude judges whether evidence meets the brief after facts pass.
ANTHROPIC_API_KEY=
# Optional: the Proof Engine's ERC-8004 agent id, to skip rediscovery.
ACCRUE_ENGINE_AGENT_ID=
# Optional: raises GitHub's API limit for pull-request checks.
GITHUB_TOKEN=
# Optional: another Arc RPC (server at runtime / browser at build time).
ARC_RPC_URL=
NEXT_PUBLIC_ARC_RPC_URL=
